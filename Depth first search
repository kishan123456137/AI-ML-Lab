graph = {
    'A': ['B', 'C'],
    'B': ['D', 'E'],
    'C': ['F', 'G'],
    'D': [],
    'E': [],
    'F': [],
    'G': []
}

def dfs(start, goal):
    stack = [start]
    visited = set()

    while stack:
        node = stack.pop()

        if node not in visited:
            visited.add(node)
            print(node, end=" ")

            if node == goal:
                print("\nGoal found!")
                return

           
            for neighbor in reversed(graph[node]):
                if neighbor not in visited:
                    stack.append(neighbor)

    print("\nGoal not found")

dfs('A', 'G')

#output
A B D E C F G 
Goal found!
